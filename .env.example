# Copy this file to `.env` (same directory) and fill in your values.
# `docker compose` reads `.env` automatically — no need to source it.
# `.env` is gitignored.

# TMDB v3 API key — enables in-UI title/episode search.
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# MakeMKV beta key for Blu-ray decryption (rotates ~monthly; get the current one at
# https://forum.makemkv.com/forum/viewtopic.php?t=1053 ). Without it, Blu-ray rips fail
# (DVD still works). NOTE: the key includes a leading "T-" — paste it whole.
MAKEMKV_APP_KEY=

# Blu-ray drive id to run in standard (non-LibreDrive) mode. REQUIRED for most
# non-LibreDrive USB BD drives on Linux: without it makemkvcon hangs at 100% CPU during
# "SDF auto" drive-firmware processing. Standard AACS mode rips 1080p Blu-ray fine
# (LibreDrive is only needed for UHD/4K). Find your drive id after one scan attempt in
# ~/.MakeMKV/MakeMKV_log.txt on the line "SDF auto vNN: <id>" (e.g. the value below).
MAKEMKV_SDF_STOP=

# Override these only if the defaults don't fit your setup.
# OUTPUT_DIR=./output
# DATA_DIR=./data          # host dir for the SQLite rip ledger (mounted at /data)
# DVD_DEVICE=/dev/sr0
# BD_SG_DEVICE=/dev/sg1    # SCSI-generic node MakeMKV uses; find via:
#                          #   ls /sys/block/sr0/device/scsi_generic/
# PUID=1000
# PGID=1000
# CDROM_GID=24

# --- Phone access (PWA Web Push + login) -------------------------------------
# Shared password gating the whole app. Unset = no auth (fine for localhost dev;
# set it before exposing the app over Tailscale). Generate the rest with `make secrets`.
APP_PASSWORD=
SESSION_SECRET=
# VAPID keypair for self-hosted Web Push (run `make secrets` to generate). Unset
# = push disabled (the notify button stays hidden).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
